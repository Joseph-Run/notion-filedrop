# Copy to .streamlit/secrets.toml and fill in — never commit the real file.
NOTION_API_KEY = "ntn_your_integration_token"
NOTION_DATA_SOURCE_ID = "your-data-source-id"

# Moderator approves each upload in Notion (tick the Approved checkbox).
REQUIRE_APPROVAL = true

# Optional hardening
# UPLOAD_PASSCODE = "shared-word-to-upload"
# MAX_UPLOAD_MB = 20
# ALLOWED_EXTENSIONS = "pdf,docx,xlsx,csv,txt,png,jpg,zip"
# SITE_NAME = "Community File Drop"

# Only for local testing against a stand-in API
# NOTION_API_BASE = "http://127.0.0.1:8080"
